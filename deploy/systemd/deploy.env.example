# /etc/eduassets/deploy.env  (mode 0600) - optional overrides for auto-deploy.sh.
REPO=/opt/api-eduassets
REPO_USER=ubuntu
GITHUB_REPO=edu-assets/api-eduassets
# GitHub Actions job names that must have succeeded for the commit before it is deployed.
REQUIRED_CHECKS="verify production-smoke"
COMPOSE_PROJECT=eduassets
HEALTH_TIMEOUT_SECONDS=180
