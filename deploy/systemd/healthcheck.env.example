# /etc/eduassets/healthcheck.env  (mode 0600) - optional overrides for vm-health-check.sh.
COMPOSE_PROJECT=eduassets
BACKUP_DIR=/var/backups/eduassets
DISK_MAX_PERCENT=85
MEM_MIN_AVAILABLE_MB=150
BACKUP_MAX_AGE_HOURS=26
UNHEALTHY_RESTART_AFTER=3
ERROR_5XX_MIN_COUNT=5
ERROR_5XX_MAX_PERCENT=5
# Optional dead-man switch (e.g. a healthchecks.io check with a 5-minute period and 10-minute grace):
# HEALTH_PING_URL=https://hc-ping.com/<uuid>
