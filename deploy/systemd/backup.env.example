# /etc/eduassets/backup.env  (mode 0600, owned by the backup user) - example values only, never commit real ones.
# This file is sourced by bash, so $(< file) works.
PATH=/usr/lib/postgresql/18/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DATABASE_URL='postgresql://USUARIO@HOST_DIRECT:5432/BANCO?sslmode=require&channel_binding=require'
PGPASSFILE=/etc/eduassets/pgpass
AGE_RECIPIENT="$(< /etc/eduassets/age-recipient.txt)"
RCLONE_DESTINATION='offsite:<bucket>/postgres'
BACKUP_DIR=/var/backups/eduassets
LOCAL_RETENTION_DAYS=7
REMOTE_RETENTION_DAYS=30
BACKUP_MIN_KEEP=3
# Optional dead-man switch (e.g. a healthchecks.io check with a 1-day period and 2h grace):
# BACKUP_PING_URL=https://hc-ping.com/<uuid>
