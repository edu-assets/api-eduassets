# Template only. Install after supplying a valid origin certificate and verifying
# the actual API hostname and trusted Cloudflare IP ranges with the operator.
# Cloudflare's current ranges must be maintained in the included file; do not
# trust CF-Connecting-IP from arbitrary Internet clients.
server {
    listen 443 ssl http2;
    server_name api.eduassets.tech;

    ssl_certificate     /etc/ssl/eduassets/origin-fullchain.pem;
    ssl_certificate_key /etc/ssl/eduassets/origin-private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100k;

    # Create this file from the currently published Cloudflare IP ranges.
    # Each range must be a set_real_ip_from directive. Do not use 0.0.0.0/0.
    include /etc/nginx/snippets/eduassets-cloudflare-realip.conf;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite client-supplied forwarding values; Express trusts this one hop only.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}

server {
    listen 80;
    server_name api.eduassets.tech;
    return 301 https://$host$request_uri;
}
