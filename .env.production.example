# TEMPLATE ONLY — replace every placeholder after verifying actual DNS/provider settings.
# Used by docker-compose.production.yml; this file is not a secret store.
NODE_ENV=production
BACKEND_PORT=3000
# This value is required by production. Generate externally: openssl rand -hex 32
JWT_SECRET=
# PostgreSQL URL from a dedicated production database; never use a demo/operational DB interchangeably.
# For a managed DB, use the provider's CA/hostname and follow its Prisma TLS options.
# Keep a separate libpq-compatible URL for pg_dump/pg_restore when needed;
# never disable TLS verification in production.
DATABASE_URL=
# Optional. If omitted, Prisma config uses DATABASE_URL. Supply only the provider's direct connection when required.
# DIRECT_URL=
# Required only for an explicit first-time seed command; do not leave these set for routine API startup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional; set both only when provisioning an editor intentionally.
# SEED_EDITOR_EMAIL=
# SEED_EDITOR_PASSWORD=
# Replace with the verified Vercel app origin; example.invalid is intentionally non-routable.
CORS_ORIGIN=https://app.example.invalid
# One trusted Nginx hop only; Nginx must sanitize and overwrite forwarded headers.
TRUST_PROXY=1
LOG_LEVEL=info
RFID_BRIDGE_ENABLED=false
# No RFID secret needed when the public instance keeps the bridge disabled.
