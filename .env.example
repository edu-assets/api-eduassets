# Backend local development only. Copy to backend/.env; never commit real values.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=0
CORS_ORIGIN=
# Prisma/application URL. Keep provider-specific Prisma options here only.
DATABASE_URL=postgresql://eduassets:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/eduassets
# For pg_dump/pg_restore/psql, use a separate shell variable with a libpq-compatible URL.
# Do not append Prisma-only parameters such as ?schema=public to that tool URL.
# DIRECT_URL is optional; Prisma falls back to DATABASE_URL when omitted.
JWT_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional; set both values to create an editor. Do not configure for public production.
# SEED_EDITOR_EMAIL=
# SEED_EDITOR_PASSWORD=
LOG_LEVEL=info
RFID_BRIDGE_ENABLED=false
# Required only for an explicitly enabled isolated kiosk (>=32 random chars).
RFID_BRIDGE_SECRET=
# Optional password recovery email: set all four SMTP_HOST/SMTP_USER/SMTP_PASS/MAIL_FROM or none.
# APP_PUBLIC_URL=http://localhost:5173
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# SUPPORT_EMAIL=
# PUBLIC_SITE_URL=
# Optional Web Push notifications for administrators: set all three VAPID_* values or none.
# Generate the key pair ONCE with: npx web-push generate-vapid-keys
# (changing the keys later invalidates every existing browser subscription). Never commit the private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@eduassets.tech
