generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Categoria {
  id           Int           @id @default(autoincrement())
  nome         String        @unique
  criadoPorId  Int?
  equipamentos Equipamento[]
  criadoPor    Usuario?      @relation("CategoriaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([criadoPorId])
}

model Equipamento {
  id                   Int              @id @default(autoincrement())
  categoriaId          Int
  modelo               String
  quantidadeTotal      Int
  quantidadeDisponivel Int
  quantidadeQuebrada   Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  criadoPorId          Int?
  atualizadoPorId      Int?
  categoria            Categoria        @relation(fields: [categoriaId], references: [id])
  criadoPor            Usuario?         @relation("EquipamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPor        Usuario?         @relation("EquipamentoAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  itensEmprestimo      ItemEmprestimo[]
  ocorrencias          Ocorrencia[]

  @@index([quantidadeDisponivel])
  @@index([quantidadeQuebrada])
  @@index([criadoPorId])
  @@index([atualizadoPorId])
  // Database CHECK constraints are declared in the versioned SQL migration (Prisma 6 has no schema attribute for CHECK).
}

model Responsavel {
  id          Int          @id @default(autoincrement())
  nome        String
  cargo       String
  /// Inactive responsible people stay referenced by historical loans but are hidden from new-loan pickers.
  ativo       Boolean      @default(true)
  criadoPorId Int?
  emprestimos Emprestimo[]
  criadoPor   Usuario?     @relation("ResponsavelCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([criadoPorId])
}

model Usuario {
  id              Int         @id @default(autoincrement())
  nome            String
  login           String      @unique
  passwordHash    String
  nivelAcesso     NivelAcesso
  ativo           Boolean     @default(true)
  sessionVersion  Int         @default(0)
  rfidTokenHash   String?     @unique
  createdById     Int?
  updatedById     Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       Usuario?    @relation("UsuarioCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       Usuario?    @relation("UsuarioUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdUsers    Usuario[]   @relation("UsuarioCreatedBy")
  updatedUsers    Usuario[]   @relation("UsuarioUpdatedBy")
  auditLogs       AuditLog[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  // Record authorship back-relations (who created/edited/returned/resolved each record).
  categoriasCriadas       Categoria[]   @relation("CategoriaCriadoPor")
  responsaveisCriados     Responsavel[] @relation("ResponsavelCriadoPor")
  equipamentosCriados     Equipamento[] @relation("EquipamentoCriadoPor")
  equipamentosAtualizados Equipamento[] @relation("EquipamentoAtualizadoPor")
  emprestimosCriados      Emprestimo[]  @relation("EmprestimoCriadoPor")
  emprestimosAtualizados  Emprestimo[]  @relation("EmprestimoAtualizadoPor")
  emprestimosDevolvidos   Emprestimo[]  @relation("EmprestimoDevolvidoPor")
  ocorrenciasCriadas      Ocorrencia[]  @relation("OcorrenciaCriadoPor")
  ocorrenciasAtualizadas  Ocorrencia[]  @relation("OcorrenciaAtualizadoPor")
  ocorrenciasResolvidas   Ocorrencia[]  @relation("OcorrenciaResolvidoPor")

  @@index([createdById])
  @@index([updatedById])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(80)
  entityId   String   @db.VarChar(120)
  changedFields String[]
  createdAt  DateTime @default(now())
  actor      Usuario  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
}

model Emprestimo {
  id              Int              @id @default(autoincrement())
  solicitanteNome String
  responsavelId   Int
  status          StatusEmprestimo @default(ABERTO)
  dataRetirada    DateTime
  dataDevolucao   DateTime?
  observacao      String?
  createdAt       DateTime         @default(now())
  criadoPorId     Int?
  atualizadoPorId Int?
  atualizadoEm    DateTime?
  devolvidoPorId  Int?
  responsavel     Responsavel      @relation(fields: [responsavelId], references: [id])
  criadoPor       Usuario?         @relation("EmprestimoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPor   Usuario?         @relation("EmprestimoAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  devolvidoPor    Usuario?         @relation("EmprestimoDevolvidoPor", fields: [devolvidoPorId], references: [id], onDelete: SetNull)
  itens           ItemEmprestimo[]

  @@index([status])
  // Loan history pages: ORDER BY "dataRetirada" DESC, id DESC with a keyset cursor and de/ate range filters.
  @@index([dataRetirada, id])
  @@index([criadoPorId])
  @@index([atualizadoPorId])
  @@index([devolvidoPorId])
}

model ItemEmprestimo {
  id            Int         @id @default(autoincrement())
  emprestimoId  Int
  equipamentoId Int
  quantidade    Int
  emprestimo    Emprestimo  @relation(fields: [emprestimoId], references: [id])
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id])

  @@index([emprestimoId])
  @@index([equipamentoId, emprestimoId])
  // Positive-quantity CHECK is declared in the versioned SQL migration.
}

model Ocorrencia {
  id              Int              @id @default(autoincrement())
  equipamentoId   Int
  numero          String?
  tipo            TipoOcorrencia
  status          StatusOcorrencia @default(ABERTO)
  problema        String
  descricao       String
  resolvidoEm     DateTime?
  medidasTomadas  String?
  createdAt       DateTime         @default(now())
  criadoPorId     Int?
  atualizadoPorId Int?
  atualizadoEm    DateTime?
  resolvidoPorId  Int?
  equipamento     Equipamento      @relation(fields: [equipamentoId], references: [id])
  criadoPor       Usuario?         @relation("OcorrenciaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPor   Usuario?         @relation("OcorrenciaAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  resolvidoPor    Usuario?         @relation("OcorrenciaResolvidoPor", fields: [resolvidoPorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([equipamentoId, status, tipo])
  @@index([criadoPorId])
  @@index([atualizadoPorId])
  @@index([resolvidoPorId])
}

enum NivelAcesso {
  ADMINISTRADOR
  EDITOR
}

enum StatusEmprestimo {
  ABERTO
  DEVOLVIDO
}

enum TipoOcorrencia {
  OBSERVACAO
  MANUTENCAO
  QUEBRADO
}

enum StatusOcorrencia {
  ABERTO
  RESOLVIDO
}

/// Single-use self-service password recovery tokens. Only a SHA-256 hash of the emailed token is stored.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// Web Push subscription of one browser/device of an administrator. No user agent or IP is stored.
model PushSubscription {
  id                  Int       @id @default(autoincrement())
  usuarioId           Int
  endpoint            String    @unique
  p256dh              String
  auth                String
  notificarEmprestimo Boolean   @default(true)
  notificarDevolucao  Boolean   @default(true)
  notificarOcorrencia Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastSuccessAt       DateTime?
  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}
