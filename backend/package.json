{
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "morgan": "^1.10.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "@types/morgan": "^1.9.10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:db": "npm run migrate:deploy",
    "build": "npm run prisma:generate && tsc",
    "test": "tsx --test tests/**/*.test.ts",
    "start": "node dist/src/server.js",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "test:integration": "tsx --test integration-tests/**/*.integration.test.ts",
    "db:seed": "prisma db seed --config prisma.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
