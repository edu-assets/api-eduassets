[Unit]
Description=eduAssets RFID Bridge
After=network.target

[Service]
Type=simple
User=eduassets
Group=eduassets
WorkingDirectory=/opt/eduassets-rfid
EnvironmentFile=/etc/eduassets/rfid_bridge.env
ExecStartPre=/bin/sh -c '[ "$(stat -c %a /etc/eduassets/rfid_bridge.env)" = 600 ]'
ExecStart=/opt/eduassets-rfid/venv/bin/python3 /opt/eduassets-rfid/rfid_admin_bridge.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
